<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StudyMate AI</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Segoe UI',sans-serif;background:#0a0a0f;color:#fff;min-height:100vh;}
.header{background:linear-gradient(135deg,#6c63ff,#3ecfcf);padding:18px 20px;display:flex;align-items:center;gap:12px;box-shadow:0 4px 20px rgba(108,99,255,0.4);}
.header h1{font-size:22px;font-weight:800;letter-spacing:1px;}
.header p{font-size:11px;opacity:0.85;}
.nav{display:flex;overflow-x:auto;gap:8px;padding:12px 15px;background:#12121a;border-bottom:1px solid #222;}
.nav button{padding:8px 16px;border:none;border-radius:20px;cursor:pointer;font-size:12px;font-weight:700;background:#1e1e2e;color:#aaa;white-space:nowrap;transition:all 0.3s;}
.nav button.active,.nav button:hover{background:linear-gradient(135deg,#6c63ff,#3ecfcf);color:#fff;}
.section{display:none;padding:20px;max-width:650px;margin:0 auto;}
.section.active{display:block;}
.card-box{background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:18px;padding:20px;margin:12px 0;border:1px solid #2a2a4a;}
h3{font-size:16px;margin-bottom:12px;color:#3ecfcf;}
input,textarea,select{width:100%;padding:12px;border-radius:10px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:14px;margin:6px 0;outline:none;}
input:focus,textarea:focus{border-color:#6c63ff;}
textarea{height:90px;resize:none;}
.btn{padding:12px 24px;border:none;border-radius:25px;cursor:pointer;font-size:14px;font-weight:700;margin:5px;transition:all 0.3s;}
.btn-primary{background:linear-gradient(135deg,#6c63ff,#3ecfcf);color:#fff;box-shadow:0 4px 15px rgba(108,99,255,0.3);}
.btn-secondary{background:#1e1e2e;color:#aaa;border:1px solid #333;}
.btn:hover{transform:translateY(-2px);}
.center{text-align:center;}
.timer-wrap{text-align:center;padding:20px 0;}
.timer-circle{width:180px;height:180px;border-radius:50%;background:linear-gradient(135deg,#6c63ff,#3ecfcf);display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0 auto 20px;box-shadow:0 0 40px rgba(108,99,255,0.5);}
.timer-circle h2{font-size:44px;font-weight:800;}
.timer-circle p{font-size:11px;opacity:0.8;}
.timer-settings{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:10px 0;}
.timer-settings label{font-size:12px;color:#aaa;}
.timer-settings input{width:70px;text-align:center;}
.fc-card{background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:15px;padding:25px;min-height:140px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:16px;cursor:pointer;border:2px solid #6c63ff;margin:12px 0;transition:all 0.3s;}
.fc-card:hover{box-shadow:0 0 20px rgba(108,99,255,0.4);}
.quiz-opt{background:#1a1a2e;border:2px solid #2a2a4a;border-radius:12px;padding:14px;margin:8px 0;cursor:pointer;transition:all 0.3s;font-size:14px;}
.quiz-opt:hover{border-color:#6c63ff;background:#1e1e2e;}
.quiz-opt.correct{background:#00b894;border-color:#00b894;}
.quiz-opt.wrong{background:#d63031;border-color:#d63031;}
.streak-box{background:linear-gradient(135deg,#f7971e,#ffd200);border-radius:18px;padding:25px;text-align:center;color:#1a1a2e;margin:12px 0;}
.streak-box h2{font-size:52px;font-weight:800;}
.badge{display:inline-block;background:linear-gradient(135deg,#6c63ff,#3ecfcf);border-radius:50px;padding:6px 16px;margin:4px;font-size:12px;}
.loading{text-align:center;padding:20px;color:#6c63ff;font-size:14px;}
.spinner{width:30px;height:30px;border:3px solid #333;border-top:3px solid #6c63ff;border-radius:50%;animation:spin 1s linear infinite;margin:10px auto;}
@keyframes spin{to{transform:rotate(360deg);}}
.feedback-item{background:#1a1a2e;border-radius:12px;padding:15px;margin:8px 0;border-left:3px solid #6c63ff;font-size:13px;}
.ad-banner{background:linear-gradient(135deg,#1a1a2e,#12121a);border:1px dashed #333;border-radius:10px;padding:15px;text-align:center;margin:15px 0;color:#555;font-size:12px;}
.tag{display:inline-block;background:#1e1e2e;border:1px solid #6c63ff;border-radius:20px;padding:4px 12px;margin:3px;font-size:12px;color:#6c63ff;}
</style>
</head>
<body>

<div class="header">
  <div>
    <h1>📚 StudyMate AI</h1>
    <p>Powered by Artificial Intelligence</p>
  </div>
</div>

<div class="nav">
  <button class="active" onclick="show('pomodoro',this)">⏱ Focus</button>
  <button onclick="show('flashcards',this)">🃏 Flashcards</button>
  <button onclick="show('quiz',this)">🧠 Quiz</button>
  <button onclick="show('streak',this)">🔥 Streak</button>
  <button onclick="show('feedback',this)">💬 Feedback</button>
</div>

<!-- ADS -->
<div style="max-width:650px;margin:0 auto;">
  <div class="ad-banner">📢 Ad space — Google AdSense coming soon</div>
</div>

<!-- POMODORO -->
<div id="pomodoro" class="section active">
  <div class="card-box">
    <h3>⏱ Focus Timer</h3>
    <div class="timer-settings">
      <div>
        <label>Focus (min)</label>
        <input type="number" id="focus-min" value="25" min="1" max="120">
      </div>
      <div>
        <label>Break (min)</label>
        <input type="number" id="break-min" value="5" min="1" max="60">
      </div>
    </div>
    <div class="timer-wrap">
      <div class="timer-circle">
        <h2 id="timer">25:00</h2>
        <p id="timer-label">Focus</p>
      </div>
      <button class="btn btn-primary" onclick="startTimer()">▶ Start</button>
      <button class="btn btn-secondary" onclick="resetTimer()">↺ Reset</button>
    </div>
    <p class="center" style="color:#aaa;font-size:13px;">Sessions today: <strong id="sessions">0</strong></p>
  </div>
</div>

<!-- FLASHCARDS -->
<div id="flashcards" class="section">
  <div class="card-box">
    <h3>🤖 AI Flashcard Generator</h3>
    <input type="text" id="fc-topic" placeholder="Enter topic (e.g. Photosynthesis, French Revolution...)">
    <button class="btn btn-primary" onclick="genFlashcards()">✨ Generate with AI</button>
    <div id="fc-loading" style="display:none;" class="loading"><div class="spinner"></div>AI is creating flashcards...</div>
  </div>
  <div class="ad-banner">📢 Advertisement</div>
  <div id="fc-display" style="display:none;">
    <div class="fc-card" id="fc-card" onclick="flipFC()">
      <p id="fc-text">Loading...</p>
    </div>
    <div class="center">
      <button class="btn btn-secondary" onclick="prevFC()">◀</button>
      <button class="btn btn-secondary" onclick="nextFC()">▶</button>
    </div>
    <p class="center" id="fc-counter" style="color:#aaa;font-size:13px;margin-top:8px;"></p>
  </div>
  <div class="card-box" style="margin-top:15px;">
    <h3>✍️ Manual Flashcard</h3>
    <input type="text" id="m-q" placeholder="Question">
    <textarea id="m-a" placeholder="Answer"></textarea>
    <button class="btn btn-primary" onclick="addManualFC()">+ Add Card</button>
  </div>
</div>

<!-- QUIZ -->
<div id="quiz" class="section">
  <div class="card-box">
    <h3>🤖 AI Quiz Generator</h3>
    <input type="text" id="quiz-topic" placeholder="Enter topic (e.g. World War 2, Algebra...)">
    <select id="quiz-difficulty">
      <option value="easy">Easy</option>
      <option value="medium" selected>Medium</option>
      <option value="hard">Hard</option>
    </select>
    <button class="btn btn-primary" onclick="genQuiz()">✨ Generate Quiz</button>
    <div id="quiz-loading" style="display:none;" class="loading"><div class="spinner"></div>AI is generating quiz...</div>
  </div>
  <div class="ad-banner">📢 Advertisement</div>
  <div id="quiz-area" style="display:none;">
    <div class="card-box">
      <p style="color:#aaa;font-size:12px;margin-bottom:8px;" id="q-num"></p>
      <p style="font-size:16px;font-weight:600;" id="q-text"></p>
      <div id="q-opts" style="margin-top:15px;"></div>
      <p id="q-feedback" style="margin-top:12px;text-align:center;font-size:15px;"></p>
      <div class="center" style="margin-top:12px;">
        <button class="btn btn-primary" onclick="nextQ()">Next ▶</button>
      </div>
      <p class="center" style="color:#aaa;font-size:13px;margin-top:8px;">Score: <span id="q-score">0</span>/<span id="q-total">0</span></p>
    </div>
  </div>
</div>

<!-- STREAK -->
<div id="streak" class="section">
  <div class="streak-box">
    <p style="font-size:14px;font-weight:700;">🔥 Study Streak</p>
    <h2 id="streak-num">0</h2>
    <p>days in a row!</p>
  </div>
  <div class="center">
    <button class="btn btn-primary" onclick="markDay()">✅ Mark Today Done!</button>
  </div>
  <div class="card-box" style="margin-top:15px;">
    <h3>🏆 Badges</h3>
    <div id="badges"><span class="badge">🌱 Beginner</span></div>
  </div>
  <div class="card-box">
    <h3>💬 Daily Quote</h3>
    <p id="daily-quote" style="font-style:italic;color:#aaa;font-size:14px;line-height:1.6;"></p>
  </div>
  <div class="ad-banner">📢 Advertisement</div>
</div>

<!-- FEEDBACK -->
<div id="feedback" class="section">
  <div class="card-box">
    <h3>💬 Suggest a Feature</h3>
    <p style="color:#aaa;font-size:13px;margin-bottom:10px;">Tell us what you want in StudyMate AI!</p>
    <input type="text" id="fb-name" placeholder="Your name (optional)">
    <textarea id="fb-text" placeholder="What feature would you like? What can we improve?"></textarea>
    <button class="btn btn-primary" onclick="submitFeedback()">📤 Submit</button>
  </div>
  <div id="fb-list" style="margin-top:15px;">
    <h3>📋 Recent Suggestions</h3>
    <div id="fb-items"></div>
  </div>
</div>

<script>
const API_KEY = 'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key';

// POMODORO
let time, running=false, interval, sessions=0, isBreak=false;
function getTime(){return isBreak ? parseInt(document.getElementById('break-min').value)*60 : parseInt(document.getElementById('focus-min').value)*60;}
function resetTimer(){clearInterval(interval);running=false;isBreak=false;time=getTime();let m=Math.floor(time/60);document.getElementById('timer').textContent=`${String(m).padStart(2,'0')}:00`;document.getElementById('timer-label').textContent='Focus';}
function startTimer(){
  if(!time) time=getTime();
  if(running){clearInterval(interval);running=false;return;}
  running=true;
  interval=setInterval(()=>{
    time--;
    let m=Math.floor(time/60),s=time%60;
    document.getElementById('timer').textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    if(time<=0){
      clearInterval(interval);running=false;
      if(!isBreak){sessions++;document.getElementById('sessions').textContent=sessions;isBreak=true;time=parseInt(document.getElementById('break-min').value)*60;document.getElementById('timer-label').textContent='Break!';alert('🎉 Focus done! Take a break!');}
      else{isBreak=false;time=parseInt(document.getElementById('focus-min').value)*60;document.getElementById('timer-label').textContent='Focus';alert('Break over! Back to focus! 💪');}
    }
  },1000);
}

// AI FLASHCARDS
let fcCards=[],fcIndex=0,fcShowQ=true;
async function genFlashcards(){
  let topic=document.getElementById('fc-topic').value.trim();
  if(!topic){alert('Topic likhو!');return;}
  document.getElementById('fc-loading').style.display='block';
  document.getElementById('fc-display').style.display='none';
  try{
    let res=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${API_KEY}`,{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({contents:[{parts:[{text:`Create 8 flashcards about "${topic}". Return ONLY a JSON array like: [{"q":"question","a":"answer"}]. No extra text.`}]}]})
    });
    let data=await res.json();
    let text=data.candidates[0].content.parts[0].text;
    let clean=text.replace(/```json|```/g,'').trim();
    fcCards=JSON.parse(clean);
    fcIndex=0;fcShowQ=true;
    document.getElementById('fc-loading').style.display='none';
    document.getElementById('fc-display').style.display='block';
    showFC();
  }catch(e){document.getElementById('fc-loading').style.display='none';alert('Error! Check API key.');}
}
function addManualFC(){
  let q=document.getElementById('m-q').value,a=document.getElementById('m-a').value;
  if(!q||!a){alert('Dono fields bharo!');return;}
  fcCards.push({q,a});document.getElementById('m-q').value='';document.getElementById('m-a').value='';
  document.getElementById('fc-display').style.display='block';
  fcIndex=fcCards.length-1;showFC();alert('Card added! ✅');
}
function showFC(){
  if(!fcCards.length)return;
  fcShowQ=true;
  document.getElementById('fc-card').innerHTML=`<div><p style="color:#6c63ff;font-size:11px;margin-bottom:8px;">TAP TO FLIP</p><p>${fcCards[fcIndex].q}</p></div>`;
  document.getElementById('fc-counter').textContent=`Card ${fcIndex+1} of ${fcCards.length}`;
}
function flipFC(){if(!fcCards.length)return;fcShowQ=!fcShowQ;document.getElementById('fc-text');document.getElementById('fc-card').innerHTML=fcShowQ?`<div><p style="color:#6c63ff;font-size:11px;margin-bottom:8px;">TAP TO FLIP</p><p>${fcCards[fcIndex].q}</p></div>`:`<div><p style="color:#3ecfcf;font-size:11px;margin-bottom:8px;">ANSWER</p><p>${fcCards[fcIndex].a}</p></div>`;}
function nextFC(){if(fcCards.length){fcIndex=(fcIndex+1)%fcCards.length;showFC();}}
function prevFC(){if(fcCards.length){fcIndex=(fcIndex-1+fcCards.length)%fcCards.length;showFC();}}

// AI QUIZ
let quizQs=[],qIndex=0,qScore=0,qTotal=0,qAnswered=false;
async function genQuiz(){
  let topic=document.getElementById('quiz-topic').value.trim();
  let diff=document.getElementById('quiz-difficulty').value;
  if(!topic){alert('Topic likho!');return;}
  document.getElementById('quiz-loading').style.display='block';
  document.getElementById('quiz-area').style.display='none';
  try{
    let res=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${API_KEY}`,{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({contents:[{parts:[{text:`Create 10 ${diff} multiple choice questions about "${topic}". Return ONLY a JSON array: [{"q":"question","o":["opt1","opt2","opt3","opt4"],"a":0}] where "a" is the index of correct answer. No extra text.`}]}]})
    });
    let data=await res.json();
    let text=data.candidates[0].content.parts[0].text;
    let clean=text.replace(/```json|```/g,'').trim();
    quizQs=JSON.parse(clean);
    qIndex=0;qScore=0;qTotal=0;
    document.getElementById('quiz-loading').style.display='none';
    document.getElementById('quiz-area').style.display='block';
    loadQ();
  }catch(e){document.getElementById('quiz-loading').style.display='none';alert('Error! Check API key.');}
}
function loadQ(){
  if(!quizQs.length)return;
  qAnswered=false;
  let q=quizQs[qIndex];
  document.getElementById('q-num').textContent=`Question ${qIndex+1} of ${quizQs.length}`;
  document.getElementById('q-text').textContent=q.q;
  document.getElementById('q-feedback').textContent='';
  let box=document.getElementById('q-opts');box.innerHTML='';
  q.o.forEach((opt,i)=>{
    let d=document.createElement('div');d.className='quiz-opt';d.textContent=opt;
    d.onclick=()=>checkQ(i,q.a,d);box.appendChild(d);
  });
  document.getElementById('q-score').textContent=qScore;
  document.getElementById('q-total').textContent=qTotal;
}
function checkQ(sel,correct,el){
  if(qAnswered)return;qAnswered=true;qTotal++;
  if(sel===correct){el.classList.add('correct');qScore++;document.getElementById('q-feedback').textContent='✅ Correct!';}
  else{el.classList.add('wrong');document.querySelectorAll('.quiz-opt')[correct].classList.add('correct');document.getElementById('q-feedback').textContent='❌ Wrong!';}
  document.getElementById('q-score').textContent=qScore;
  document.getElementById('q-total').textContent=qTotal;
}
function nextQ(){qIndex=(qIndex+1)%quizQs.length;loadQ();}

// STREAK
let streak=parseInt(localStorage.getItem('sm-streak')||'0');
let lastDate=localStorage.getItem('sm-date')||'';
document.getElementById('streak-num').textContent=streak;
const quotes=["Believe you can and you're halfway there! 🌟","Every expert was once a beginner. Keep going! 💪","Small steps every day lead to big results! 🚀","You are capable of amazing things! ⭐","Study hard today, shine bright tomorrow! ☀️","Success is the sum of small efforts repeated daily! 🎯"];
document.getElementById('daily-quote').textContent=quotes[new Date().getDay()%quotes.length];
function markDay(){
  let today=new Date().toDateString();
  if(lastDate===today){alert('Already marked today! Keep it up! 🔥');return;}
  streak++;lastDate=today;
  localStorage.setItem('sm-streak',streak);localStorage.setItem('sm-date',today);
  document.getElementById('streak-num').textContent=streak;
  let badges=document.getElementById('badges');
  if(streak>=7)badges.innerHTML+='<span class="badge">🔥 Week Warrior</span>';
  if(streak>=30)badges.innerHTML+='<span class="badge">⭐ Month Master</span>';
  if(streak>=100)badges.innerHTML+='<span class="badge">👑 Legend</span>';
  alert(`Day ${streak} done! Amazing! 🎉`);
}

// FEEDBACK
let feedbacks=JSON.parse(localStorage.getItem('sm-fb')||'[]');
function renderFeedbacks(){
  let box=document.getElementById('fb-items');
  if(!feedbacks.length){box.innerHTML='<p style="color:#555;font-size:13px;">No suggestions yet. Be the first!</p>';return;}
  box.innerHTML=feedbacks.slice(-5).reverse().map(f=>`<div class="feedback-item"><strong style="color:#6c63ff;">${f.name||'Anonymous'}</strong><br>${f.text}</div>`).join('');
}
function submitFeedback(){
  let name=document.getElementById('fb-name').value;
  let text=document.getElementById('fb-text').value.trim();
  if(!text){alert('Kuch likho!');return;}
  feedbacks.push({name,text});
  localStorage.setItem('sm-fb',JSON.stringify(feedbacks));
  document.getElementById('fb-name').value='';document.getElementById('fb-text').value='';
  renderFeedbacks();alert('Thanks for your feedback! 🙏');
}
renderFeedbacks();

// NAV
function show(id,btn){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  btn.classList.add('active');
}
</script>
</body>
</html>
